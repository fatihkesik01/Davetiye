FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props Davetiye.slnx global.json ./
COPY src/backend/Davetiye.Domain/Davetiye.Domain.csproj src/backend/Davetiye.Domain/
COPY src/backend/Davetiye.Application/Davetiye.Application.csproj src/backend/Davetiye.Application/
COPY src/backend/Davetiye.Infrastructure/Davetiye.Infrastructure.csproj src/backend/Davetiye.Infrastructure/
COPY tools/Davetiye.DatabaseMigrator/Davetiye.DatabaseMigrator.csproj tools/Davetiye.DatabaseMigrator/
RUN dotnet restore tools/Davetiye.DatabaseMigrator/Davetiye.DatabaseMigrator.csproj

COPY src/backend/ src/backend/
COPY tools/Davetiye.DatabaseMigrator/ tools/Davetiye.DatabaseMigrator/
RUN dotnet publish tools/Davetiye.DatabaseMigrator/Davetiye.DatabaseMigrator.csproj -c Release --no-restore -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish ./
USER app
ENTRYPOINT ["dotnet", "Davetiye.DatabaseMigrator.dll"]
