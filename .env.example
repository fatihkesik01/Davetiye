# Copy to .env only on the target host. Do not commit actual values.
POSTGRES_DB=davetiye
POSTGRES_USER=davetiye
POSTGRES_PASSWORD=replace-with-a-long-random-secret
PUBLIC_WEB_BASE_URL=https://example.invalid
PUBLIC_WEB_ORIGIN=https://example.invalid
# Phase 11 only: Resend account setup. Leave blank until sender/domain verification is complete.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_FROM_NAME=Davetiye
# Non-secret CSP origins; set in Phase 11 to match CloudflareMedia:WorkerBaseUrl and
# CloudflareMedia:StreamCustomerHostname. Leave empty while production media is disabled.
CSP_MEDIA_WORKER_ORIGIN=
CSP_STREAM_CUSTOMER_ORIGIN=
# Phase 11 only. Keep media disabled and these values empty until real-provider acceptance.
CLOUDFLARE_MEDIA_ENABLED=false
CLOUDFLARE_MEDIA_WORKER_BASE_URL=
CLOUDFLARE_MEDIA_IMAGE_CAPABILITY_SIGNING_KEY_BASE64URL=
CLOUDFLARE_MEDIA_WORKER_BROKER_AUTHORIZATION_KEY=
CLOUDFLARE_MEDIA_STREAM_WEBHOOK_SECRET=
CLOUDFLARE_MEDIA_WEBHOOK_MAX_AGE_SECONDS=300
CLOUDFLARE_MEDIA_MAXIMUM_VIDEO_PLAYBACK_SESSION_SECONDS=1800
CLOUDFLARE_MEDIA_STREAM_CUSTOMER_HOSTNAME=
